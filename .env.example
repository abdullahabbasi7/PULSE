# Copy to backend/.env when running the backend without Docker.
# Docker Compose already sets these; you only need this file for a local run.

# App connection — pulse_app cannot bypass row-level security.
DATABASE_URL=postgresql+psycopg://pulse_app:pulse_app_dev@localhost:5432/pulse
# Migration connection — the table owner, used only by Alembic.
MIGRATION_DATABASE_URL=postgresql+psycopg://pulse:pulse_dev@localhost:5432/pulse

# Use a long random value outside development:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=pulse-development-secret-change-me-0123456789
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]
